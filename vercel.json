{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "github": {
    "autoAlias": true
  },
  "headers": [
    {
      "source": "/adobe-bridge.html",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/((?!adobe-bridge\\.html$).*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/gs-wasm/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/libre-wasm/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/tesseract/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        { "source": "/((?!assets/|gs-wasm/|libre-wasm/|tesseract/|api/|.*\\..*).*)", "destination": "/index.html" }
      ]
    },
    "adobe": {
      "root": "services/adobe",
      "framework": "node",
      "entrypoint": "server.js",
      "functions": {
        "server.js": {
          "maxDuration": 300
        }
      },
      "rewrites": [
        { "source": "/(.*)", "destination": "/" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/adobe", "destination": { "service": "adobe", "path": "/" } },
    { "source": "/api/adobe/(.*)", "destination": { "service": "adobe", "path": "/" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
