# CloudConvert API key for PDF → Word and Word → PDF.
# Server-side only — never expose this as a VITE_ variable.
CLOUDCONVERT_API_KEY=

# iLovePDF project keys for PDF to Word iLove.
# Server-side only — never expose these as VITE_ variables.
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=
# Optional override for the iLovePDF start tool (default: pdfoffice).
ILOVEPDF_TOOL=

# Local conversion service (HTML → PDF from a URL only)
# See services/word-to-pdf/.env.example

# --- Monetization (Vite / client) ---
# Manual affiliates: paste URLs in src/lib/affiliate-config.ts OR set these
# (env wins). Same card layout as on tool pages.
VITE_AFFILIATE_HOSTINGER_URL=
VITE_AFFILIATE_CLOUDWAYS_URL=

# Google AdSense — apply at https://www.google.com/adsense/ then paste IDs.
# Dedicated placements are reserved in the layout site-wide.
VITE_ADSENSE_CLIENT=
# Optional: let Google Auto ads place extra units (true/false)
VITE_ADSENSE_AUTO=false

# Per-placement ad unit slot IDs (create units in AdSense → Ads → Ad units)
VITE_ADSENSE_SLOT_HOME_BELOW_TOOLS=
VITE_ADSENSE_SLOT_HOME_BELOW_CONTENT=
VITE_ADSENSE_SLOT_TOOL_AFTER_UPLOAD=
VITE_ADSENSE_SLOT_TOOL_AFTER_SEO=
VITE_ADSENSE_SLOT_FOOTER=

# Legacy aliases (still work as fallbacks for tool/home content slots)
VITE_ADSENSE_SLOT_INARTICLE=
VITE_ADSENSE_SLOT_SIDEBAR=
