# Adobe PDF Services credentials for PDF → Word and Word → PDF.
# Values come from pdfservices-api-credentials.json in the Adobe credentials zip.
# Server-side only — never expose these as VITE_ variables.
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# Alternatively paste the whole credentials JSON into one variable:
# PDF_SERVICES_CREDENTIALS_JSON={"client_credentials":{"client_id":"...","client_secret":"..."}}

# Local conversion service (HTML → PDF from a URL only)
# See services/word-to-pdf/.env.example
