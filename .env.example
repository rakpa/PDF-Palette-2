# CloudConvert API key for PDF → Word and Word → PDF.
# Server-side only — never expose this as a VITE_ variable.
CLOUDCONVERT_API_KEY=

# iLovePDF project keys for PDF to Word iLove.
# Server-side only — never expose these as VITE_ variables.
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=
# Optional override for the iLovePDF start tool (default: pdfoffice).
ILOVEPDF_TOOL=

# Local conversion service (HTML → PDF from a URL only)
# See services/word-to-pdf/.env.example
