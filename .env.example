# CloudConvert API key for PDF → Word and Word → PDF.
# Server-side only — never expose this as a VITE_ variable.
CLOUDCONVERT_API_KEY=

# Local conversion service (HTML → PDF from a URL only)
# See services/word-to-pdf/.env.example

# Apryse WebViewer licence key for the "PDF to Word 2" preview card.
# Unlike CLOUDCONVERT_API_KEY this one is domain-locked and meant to run in the
# browser, so VITE_ is correct here. Without it the viewer works but stamps a
# demo watermark on what it renders.
VITE_APRYSE_LICENSE_KEY=
